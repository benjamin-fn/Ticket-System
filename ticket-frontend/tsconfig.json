{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "jsx": "react-jsx",                // ⬅️ VIKTIG!
    "moduleResolution": "Bundler",
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "verbatimModuleSyntax": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]                 // ⬅️ alias (om du använder "@/...")
    },

    "types": ["vite/client"]           // ⬅️ så Vite-typer hittas
  },
  "include": ["src"]
}
